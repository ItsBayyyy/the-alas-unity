  shots:
  - caption: Malam itu, mobilmu mogok di tepi alas.
    duration: 6.5
    fromPosition: {x: 4.452385, y: 18, z: -38.5873}
    toPosition: {x: 13.452385, y: 5, z: -17.5873}
    lookAt: {x: 18.452385, y: 1, z: -6.5872993}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: "Kunci, ban, aki, bensin, oli\u2026 semuanya tercecer di dalam hutan."
    duration: 6
    fromPosition: {x: 12.952385, y: 1.3, z: -11.087299}
    toPosition: {x: 14.852385, y: 1, z: -9.587299}
    lookAt: {x: 18.952385, y: 0.8, z: -6.5872993}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: Ada yang menunggu di antara pepohonan.
    duration: 7
    fromPosition: {x: 21.952385, y: 1.65, z: -11.587299}
    toPosition: {x: 21.952385, y: 1.6, z: -15.587299}
