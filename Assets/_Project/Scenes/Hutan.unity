    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: "Filter oli, stir, kunci, knalpot, aki\u2026 semuanya tercecer di dalam
