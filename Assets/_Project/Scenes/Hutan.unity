    lookAtEnd: {x: 20.452385, y: 1, z: -6.9872994}
    showEyes: 0
    fadeIn: 1
    fadeOut: 0
    flashlight: 1
  - caption: 'Satu-satunya jalan pulang: hidupkan lagi mobil ini.'
    duration: 5
    fromPosition: {x: 23.652386, y: 0.95, z: -9.3873}
    toPosition: {x: 22.052385, y: 1.65, z: -11.1873}
