    lookAtEnd: {x: 16.452385, y: 1.1, z: -6.9872994}
    showEyes: 0
    fadeIn: 0
    fadeOut: 0
    flashlight: 1
  - caption: Dengarkan langkahmu sendiri.
    duration: 5
    fromPosition: {x: 22.052385, y: 1.65, z: -11.1873}
    toPosition: {x: 21.952385, y: 1.65, z: -11.587299}
