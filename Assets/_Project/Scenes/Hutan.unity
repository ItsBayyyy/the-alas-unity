  - {fileID: 2146430388}
  shots:
  - caption: Malam itu, mobilmu mogok di tepi alas.
    duration: 6.5
    fromPosition: {x: 4.452385, y: 18, z: -38.5873}
    toPosition: {x: 13.452385, y: 5, z: -17.5873}
    lookAt: {x: 18.452385, y: 1, z: -6.5872993}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: "Kunci, knalpot, aki, setir, filter oli\u2026 semuanya tercecer di dalam
      hutan."
    duration: 6
    fromPosition: {x: 12.952385, y: 1.3, z: -11.087299}
    toPosition: {x: 14.852385, y: 1, z: -9.587299}
    lookAt: {x: 18.952385, y: 0.8, z: -6.5872993}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: Ada yang menunggu di antara pepohonan.
    duration: 7
    fromPosition: {x: 21.952385, y: 1.65, z: -11.587299}
    toPosition: {x: 21.952385, y: 1.6, z: -15.587299}
    lookAt: {x: 21.952385, y: 2.8, z: -25.5873}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 1
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  titleLines:
  - Ia tidak melihat. Ia mendengar.
  - Sedikit itu cukup. Banyak itu petaka.
  povShots:
  - caption: Mesinnya mati total.
    duration: 5.5
    fromPosition: {x: 23.652386, y: 0.9, z: -9.3873}
    toPosition: {x: 23.652386, y: 0.95, z: -9.3873}
    lookAt: {x: 22.952385, y: 0, z: -10.587299}
    lookAtEnd: {x: 20.452385, y: 1, z: -6.9872994}
    showEyes: 0
    fadeIn: 1
    fadeOut: 0
    flashlight: 1
  - caption: 'Satu-satunya jalan pulang: hidupkan lagi mobil ini.'
    duration: 5
    fromPosition: {x: 23.652386, y: 0.95, z: -9.3873}
    toPosition: {x: 22.052385, y: 1.65, z: -11.1873}
