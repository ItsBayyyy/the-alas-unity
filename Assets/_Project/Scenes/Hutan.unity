  - {fileID: 1108627287}
  shots:
  - caption: Malam itu, mobilmu mogok di tepi alas.
    duration: 6.5
    fromPosition: {x: -14, y: 21.143808, z: 40}
    toPosition: {x: -5, y: 8.143807, z: 61}
    lookAt: {x: 0, y: 4.1438074, z: 72}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: "Kunci, busi, aki, bensin\u2026 semuanya tertinggal di dalam hutan."
    duration: 6
    fromPosition: {x: -5.5, y: 4.4438076, z: 67.5}
    toPosition: {x: -3.6, y: 4.1438074, z: 69}
    lookAt: {x: 0.5, y: 3.9438076, z: 72}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: Ada yang menunggu di antara pepohonan.
    duration: 7
    fromPosition: {x: 3.5, y: 4.7938075, z: 67}
    toPosition: {x: 3.5, y: 4.7438073, z: 63}
    lookAt: {x: 3.5, y: 5.620515, z: 53}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 1
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  titleLines:
  - Ia tidak melihat. Ia mendengar.
  - Sedikit itu cukup. Banyak itu petaka.
  povShots:
  - caption: Mesinnya mati total.
    duration: 5.5
    fromPosition: {x: 5.2, y: 4.0438075, z: 69.2}
    toPosition: {x: 5.2, y: 4.0938077, z: 69.2}
    lookAt: {x: 4.5, y: 3.1438074, z: 68}
    lookAtEnd: {x: 2, y: 4.1438074, z: 71.6}
    showEyes: 0
    fadeIn: 1
    fadeOut: 0
    flashlight: 1
  - caption: 'Satu-satunya jalan pulang: hidupkan lagi mobil ini.'
    duration: 5
    fromPosition: {x: 5.2, y: 4.0938077, z: 69.2}
    toPosition: {x: 3.6, y: 4.7938075, z: 67.4}
    lookAt: {x: 2, y: 4.1438074, z: 71.6}
    lookAtEnd: {x: -2, y: 4.243808, z: 71.6}
    showEyes: 0
    fadeIn: 0
    fadeOut: 0
    flashlight: 1
  - caption: Dengarkan langkahmu sendiri.
    duration: 5
    fromPosition: {x: 3.6, y: 4.7938075, z: 67.4}
    toPosition: {x: 3.5, y: 4.7938075, z: 67}
    lookAt: {x: -2, y: 4.243808, z: 71.6}
    lookAtEnd: {x: 3.499999, y: 4.7938075, z: 57}
    showEyes: 0
    fadeIn: 0
    fadeOut: 0
    flashlight: 1
