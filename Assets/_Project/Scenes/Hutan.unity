  - {fileID: 341618181}
  - {fileID: 676689419}
  shots:
  - caption: Malam itu, mobilmu mogok di tepi alas.
    duration: 6.5
    fromPosition: {x: -74, y: 25, z: 88}
    toPosition: {x: -65, y: 12, z: 109}
    lookAt: {x: -60, y: 8, z: 120}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: "Kunci, ban, aki, bensin, oli\u2026 semuanya tercecer di dalam hutan."
    duration: 6
    fromPosition: {x: -65.5, y: 8.3, z: 115.5}
    toPosition: {x: -63.6, y: 8, z: 117}
    lookAt: {x: -59.5, y: 7.8, z: 120}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 0
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  - caption: Ada yang menunggu di antara pepohonan.
    duration: 7
    fromPosition: {x: -56.5, y: 8.65, z: 115}
    toPosition: {x: -56.5, y: 8.599999, z: 111}
    lookAt: {x: -56.5, y: 9.8, z: 101}
    lookAtEnd: {x: 0, y: 0, z: 0}
    showEyes: 1
    fadeIn: 1
    fadeOut: 1
    flashlight: 0
  titleLines:
  - Ia tidak melihat. Ia mendengar.
  - Sedikit itu cukup. Banyak itu petaka.
  povShots:
  - caption: Mesinnya mati total.
    duration: 5.5
    fromPosition: {x: -54.8, y: 7.9, z: 117.2}
    toPosition: {x: -54.8, y: 7.9500003, z: 117.2}
    lookAt: {x: -55.5, y: 7, z: 116}
    lookAtEnd: {x: -58, y: 8, z: 119.6}
    showEyes: 0
    fadeIn: 1
    fadeOut: 0
    flashlight: 1
  - caption: 'Satu-satunya jalan pulang: hidupkan lagi mobil ini.'
    duration: 5
    fromPosition: {x: -54.8, y: 7.9500003, z: 117.2}
    toPosition: {x: -56.4, y: 8.65, z: 115.4}
    lookAt: {x: -58, y: 8, z: 119.6}
    lookAtEnd: {x: -62, y: 8.1, z: 119.6}
    showEyes: 0
    fadeIn: 0
    fadeOut: 0
    flashlight: 1
  - caption: Dengarkan langkahmu sendiri.
